{
  "schemaVersion": 1,
  "runs": 3,
  "tasks": ["plan-ui-change", "trace-shared-package", "review-test-contract", "separate-mixed-change", "report-dynamic-boundary", "review-follow-up"],
  "arms": ["generic", "qamap-cold", "qamap-warm"],
  "provider": {
    "nameEnv": "QAMAP_BENCH_PROVIDER",
    "modelEnv": "QAMAP_BENCH_MODEL",
    "apiKeyEnv": "QAMAP_BENCH_API_KEY"
  },
  "maxOutputTokens": 4096,
  "maxProviderRequests": 100,
  "requestTimeoutMs": 60000,
  "carryOverPaths": [],
  "systemPrompt": "scripts/agent-bench/prompts/system.md"
}
